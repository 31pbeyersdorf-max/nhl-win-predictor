    "# One row per game, with home and away teams side by side (all games, including shootouts)\n",
    "h = all_games[all_games[\"home_or_away\"] == \"HOME\"][[\"gameId\", \"gameDate\", \"season\", \"team\", \"goal_diff\"]]\n",
    "h = h.rename(columns={\"team\": \"home_team\"})\n",
    "a = all_games[all_games[\"home_or_away\"] == \"AWAY\"][[\"gameId\", \"team\"]].rename(columns={\"team\": \"away_team\"})\n",
    "g = h.merge(a, on=\"gameId\").sort_values([\"gameDate\", \"gameId\"]).reset_index(drop=True)\n",
    "\n",
    "K = 6            # how fast ratings react to results\n",
    "HOME_ADV = 50    # rating points of home-ice advantage\n",
    "ratings = {}\n",
    "elo_probs = []\n",
    "last_season = None\n",
    "\n",
    "for row in g.itertuples():\n",
    "    # between seasons, pull every team 25% back toward average\n",
    "    if last_season is not None and row.season != last_season:\n",
    "        for t in ratings:\n",
    "            ratings[t] = 0.75 * ratings[t] + 0.25 * 1500\n",
    "    last_season = row.season\n",
    "\n",
    "    rh = ratings.get(row.home_team, 1500)\n",
    "    ra = ratings.get(row.away_team, 1500)\n",
    "\n",
    "    p = 1 / (1 + 10 ** (-((rh + HOME_ADV) - ra) / 400))   # predicted home win prob\n",
    "    elo_probs.append(p)                                    # saved BEFORE updating\n",
    "\n",
    "    result = 1.0 if row.goal_diff > 0 else (0.0 if row.goal_diff < 0 else 0.5)\n",
    "    ratings[row.home_team] = rh + K * (result - p)\n",
    "    ratings[row.away_team] = ra - K * (result - p)\n",
    "\n",
    "g[\"elo_prob\"] = elo_probs\n",
    "\n",
    "test_elo = test.merge(g[[\"gameId\", \"elo_prob\"]], on=\"gameId\")\n",
    "elo_p = test_elo[\"elo_prob\"]\n",
    "elo_pred = (elo_p > 0.5).astype(int)\n",
    "\n",
    "print(\"Always home          | acc:\", round(y_test.mean(), 4))\n",
    "print(\"Elo                  | acc:\", round(accuracy_score(test_elo[\"home_win\"], elo_pred), 4),\n",
    "      \"| log loss:\", round(log_loss(test_elo[\"home_win\"], elo_p), 4))\n",
    "print(\"Logistic regression  | acc:\", round(accuracy_score(y_test, preds), 4),\n",
    "      \"| log loss:\", round(log_loss(y_test, probs), 4))"
